#!/bin/sh
# Rechaza cualquier commit cuyo mensaje atribuya autoría a Claude o a
# Anthropic. Los commits de este repositorio van solo a nombre de su autor.
#
# Activado con:  git config core.hooksPath .githooks
# (ya hecho en esta copia; hay que repetirlo en cada clon nuevo)

mensaje="$1"

if grep -Eiq 'co-authored-by:[[:space:]]*claude|noreply@anthropic\.com|generated with \[?claude|claude\.com/claude-code|claude-session:' "$mensaje"; then
  echo "commit-msg: el mensaje atribuye autoría a Claude." >&2
  echo "Quita la línea (Co-Authored-By / Generated with Claude Code) y repite el commit." >&2
  exit 1
fi

exit 0
